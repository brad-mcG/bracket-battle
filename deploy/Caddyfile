# Caddy in the web container (CT 120). Caddy strips /brackets before proxying, so the app
# itself still lives at "/" on 127.0.0.1:3002; the client uses relative URLs to match.
{
	# admin API on a socket only caddy's own user can reach, not on localhost:2019
	admin unix//var/lib/caddy/admin.sock
}

(brackets) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	redir /brackets /brackets/ 308
	handle_path /brackets/* {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:3002
	}
	# Dogpile (the kids brawler, A:\dogpile) is static files served straight from disk; its own
	# deploy/push.sh fills /opt/dogpile. Same headers and compression as the brackets.
	redir /dogpile /dogpile/ 308
	handle_path /dogpile/* {
		reverse_proxy /ws 127.0.0.1:3003   # the co-op room (dogpile.service); WebSocket upgrades pass through
		header Cache-Control "no-cache"    # revalidate every visit: a day-old cached main.js once ran against a new server
		root * /opt/dogpile
		file_server
	}
	# The arcade (A:\arcade): fourteen minigames on ONE page and ONE room server (arcade.service on
	# 127.0.0.1:3004). /arcade/ holds the files and the WebSocket; each game's own path serves the
	# same page, which reads the game from the address. Its deploy/push.sh fills /opt/arcade.
	@arcadeGames path /lifeboat /lifeboat/ /dibs /dibs/ /catch /catch/ /pyramid /pyramid/ /fieldtrip /fieldtrip/ /casket /casket/ /toothfairy /toothfairy/ /lastride /lastride/ /codeblue /codeblue/ /reveal /reveal/ /texting /texting/ /potluck /potluck/ /seance /seance/ /furseason /furseason/
	handle @arcadeGames {
		header Cache-Control "no-cache"
		root * /opt/arcade/web
		rewrite * /index.html
		file_server
	}
	handle /arcade/ws {
		reverse_proxy 127.0.0.1:3004   # the room server only answers this exact path, so it is not stripped
	}
	handle_path /arcade/* {
		header Cache-Control "no-cache"
		root * /opt/arcade/web
		file_server
	}
	# The hub (A:\home): one static page at the root with a card per game. /home is an alias,
	# and any path nothing else claims shows the hub instead of a 404.
	redir /home /  308
	redir /home/ / 308
	handle {
		root * /opt/home
		try_files {path} /index.html
		file_server
	}
}

# LAN-only address, plain HTTP (no certificate possible for an IP). Handy from inside the
# house if the router doesn't loop the public name back.
http://192.168.4.250 {
	import brackets
}

# Public site. Caddy fetches and renews the Let's Encrypt certificate itself and
# redirects plain http to https. Needs router forwards 80 + 443 -> 192.168.4.250.
# Changing the certificate authority needs `systemctl restart caddy`, not reload.
ddns.themcglawns.net {
	header Strict-Transport-Security "max-age=31536000"
	import brackets
}
